# Copy this file to one of:
# - .env.development.local
# - .env.preview.local
# - .env.production.local
#
# Resolution order is:
# .env -> .env.local -> .env.<APP_ENV> -> .env.<APP_ENV>.local -> process.env
#
# APP_ENV defaults to EAS_BUILD_PROFILE, then NODE_ENV, then development.

SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-me
SUPABASE_DB_PUB_KEY=replace-me

# Optional IPv4-safe connection string for migrations from machines that
# cannot reach the direct IPv6-only db.<project-ref>.supabase.co host.
# Example format from Supabase docs:
# SUPABASE_DB_URL=postgres://postgres.your-project-ref:replace-me@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Optional explicit Expo overrides.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me
