{
  "name": "bourbon-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "supabase:apply": "node scripts/apply-supabase-schema.mjs",
    "supabase:seed": "node scripts/seed-supabase.mjs",
    "supabase:seed:sql": "node scripts/generate-seed-sql.mjs --write supabase/seed.sql",
    "supabase:bootstrap": "npm run supabase:apply && npm run supabase:seed",
    "typecheck": "tsc --noEmit",
    "seed:validate": "node scripts/validate-seed.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@supabase/supabase-js": "^2.111.0",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/react": "~19.2.17",
    "pg": "^8.22.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
