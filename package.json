{
  "name": "bourbon-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "supabase:apply": "node scripts/apply-supabase-schema.mjs",
    "supabase:seed": "node scripts/seed-supabase.mjs",
    "supabase:seed:sql": "node scripts/generate-seed-sql.mjs --write supabase/seed.sql",
    "supabase:bootstrap": "npm run supabase:apply && npm run supabase:seed",
    "typecheck": "tsc --noEmit",
    "seed:validate": "node scripts/validate-seed.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.18",
    "pg": "^8.23.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
